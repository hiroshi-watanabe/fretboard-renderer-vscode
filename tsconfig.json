{
	"compilerOptions": {
		"module": "CommonJS",
		"target": "ES2020",
		"moduleResolution": "Node",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noImplicitAny": true,
		// "DOM" is needed even though this extension never touches the DOM itself: it type-
		// checks the shared ../src/render/svg-builder.ts and render-fretboard.ts files too
		// (pulled in transitively), which also contain the Obsidian-only `toDom()` path.
		"lib": ["ES2020", "DOM"],
		// Nothing here imports "obsidian" directly, but the shared render-fretboard.ts
		// (pulled in transitively) uses Obsidian's ambient HTMLElement.empty()/.createDiv()
		// extensions in its Obsidian-only renderFretboard()/renderFretboardRow() functions —
		// TS only picks those global augmentations up if something in the program actually
		// references the package, which "types" forces even without an import. Listing
		// "types" at all disables TS's usual auto-include-everything-under-@types/ behavior,
		// so "node" has to be listed explicitly too, or node:fs/node:path stop resolving.
		"types": ["obsidian", "node"]
	},
	"include": ["src/**/*.ts"]
}
